{
  "name": "trellis-mcp-server",
  "version": "0.2.0",
  "description": "MCP server for driving a local Trellis.2 image->3D (->STL/GLB/...) service on a DGX Spark.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "trellis-mcp": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test:smoke": "node ../tests/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
